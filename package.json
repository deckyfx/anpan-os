{
  "name": "anpan-os",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run typecheck && bun run build.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "bun run src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --bail tests/"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@libsql/client": "^0.17.3",
    "@monaco-editor/react": "^4.7.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "lucide-react": "^1.14.0",
    "plyr": "^3.8.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "viewerjs": "^1.11.7",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.2.4"
