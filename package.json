    "@simplewebauthn/server": "^13.3.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "lucide-react": "^1.16.0",
    "plyr": "^3.8.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viewerjs": "^1.11.7",
