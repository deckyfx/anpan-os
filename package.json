{
  "name": "anpan-os",
  "version": "0.10.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run scripts/embed-migrations.ts && bun run typecheck && bun run build.ts",
    "deploy": "bun run build && ARCH=$(uname -m); [ \"$ARCH\" = \"aarch64\" ] && ARCH=arm64 || ARCH=x64; sudo systemctl stop anpan-os; sudo cp binaries/anpan-os-linux-$ARCH /usr/local/bin/anpan-os && sudo systemctl restart anpan-os && sudo journalctl -u anpan-os -n 20 --no-pager",
    "typecheck": "tsc --noEmit",
    "migrate": "bun run src/db/migrate.ts",
    "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --bail tests/",
    "embed-migrations": "bun run scripts/embed-migrations.ts"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/jwt": "^1.4.2",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "lucide-react": "^1.33.0",
    "music-metadata": "^11.15.0",
    "node-id3": "^0.2.9",
    "plyr": "^3.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viewerjs": "^1.11.8",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "overrides": {
    "typescript": "^7"
  }
}
